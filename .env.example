# ──────────────────────────────────────────────
# PostgreSQL
# ──────────────────────────────────────────────
POSTGRES_USER=transcriptflow
POSTGRES_PASSWORD=changeme                    # Set a strong password in production
POSTGRES_DB=transcriptflow

# ──────────────────────────────────────────────
# Go API & Worker (shared)
# ──────────────────────────────────────────────
# For local dev, point to localhost. Docker Compose overrides these internally.
DATABASE_URL=postgres://transcriptflow:changeme@localhost:5432/transcriptflow?sslmode=disable
REDIS_URL=redis://localhost:6379

# ──────────────────────────────────────────────
# Go API server
# ──────────────────────────────────────────────
PORT=8080
JWT_SECRET=replace-with-32-plus-random-bytes  # openssl rand -hex 32

# ──────────────────────────────────────────────
# Go Worker
# ──────────────────────────────────────────────
WORKER_CONCURRENCY=5
WHISPER_URL=http://localhost:9000             # Points to whisper service

# ──────────────────────────────────────────────
# Stripe (required for billing)
# ──────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...                 # From Stripe dashboard → API keys
STRIPE_WEBHOOK_SECRET=whsec_...              # From Stripe dashboard → Webhooks
STRIPE_PRO_PRICE_ID=price_...                # $10/month recurring price ID
APP_URL=http://localhost                      # Frontend base URL for Stripe redirect

# ──────────────────────────────────────────────
# Whisper service (Python / Faster-Whisper)
# ──────────────────────────────────────────────
WHISPER_MODEL=base.en                         # base.en | small.en | medium.en | large-v3
WHISPER_DEVICE=cpu                            # cpu | cuda
WHISPER_COMPUTE_TYPE=int8                     # int8 (CPU) | float16 (GPU)
WHISPER_BEAM_SIZE=5
