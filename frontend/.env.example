# Frontend build-time config (Vite). Copy to `.env` to override.
# Only VITE_-prefixed vars are exposed to the client.

# Full API root shown in the Developer → Quickstart examples.
# Leave unset to use the current origin + /api (correct in dev via the Vite
# proxy and in prod via nginx). Set this only when the API is on a separate host.
# VITE_API_BASE_URL=https://api.transcriptflow.io/api
